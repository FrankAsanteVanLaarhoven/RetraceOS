{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "RETRACE_API"
        }
      ]
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "installCommand": "pip install '.[postgres]'"
    }
  },
  "rewrites": [
    { "source": "/api/assistant", "destination": { "service": "web" } },
    { "source": "/api/assistant/(.*)", "destination": { "service": "web" } },
    { "source": "/mcp", "destination": { "service": "api" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
